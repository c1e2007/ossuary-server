[[interface]]
name = "interface.tester_hub"
width = 512
height = 334
on_load = ["clientscript.tester_hub_init", "component.tester_hub:border"]

[[component]]
name = "border"
type = "layer"
width = 512
height = 334
no_click_through = true

[[component]]
name = "content"
type = "layer"
x = 10
y = 36
width = 492
height = 288

[[component]]
name = "h_tp"
type = "text"
parent = "content"
x = 0
y = 0
width = 236
height = 18
text = "Teleports"
font = "bold"
h_align = "left"
v_align = "center"
color = "#FF981F"
text_shadow = true

[[component]]
name = "tp_tfa_bg"
type = "rectangle"
parent = "content"
x = 0
y = 22
width = 236
height = 26
filled = true
color = "#2B241A"
opacity = 40

[[component]]
name = "tp_tfa_edge"
type = "rectangle"
parent = "content"
x = 0
y = 22
width = 236
height = 26
filled = false
color = "#6B5A3C"

